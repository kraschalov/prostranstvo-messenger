# Адрес и порт, на котором слушает нода (за Nginx reverse proxy)
HOST=0.0.0.0
PORT=5050

# Публичный домен этого сервера, например: mes.example.com
SERVER_DOMAIN=localhost

# Псевдоним сервера для каталога (показывается вместо IP/host)
SERVER_NAME=

# Город сервера (показывается в каталоге)
SERVER_CITY=

# Код-приглашение для первого входа владельца (SUPER_ADMIN).
# Создаётся автоматически при первом запуске, если SUPER_ADMIN ещё не зарегистрирован.
# Удалите эту строку после первого входа.
ADMIN_BOOTSTRAP_CODE=

# Имя, которое получит владелец сервера при первом входе
ADMIN_USERNAME=admin

# Путь к файлу базы данных SQLite
DB_PATH=./data/node.db

# Путь к файлу идентификации узла
IDENTITY_PATH=./data/identity.json

# Срок жизни сессии REST (часы)
SESSION_TTL_HOURS=720

# Интервал подачи апелляции для заблокированных устройств (дней)
APPEAL_INTERVAL_DAYS=7

# Время жизни сообщения в оперативной памяти (секунды), после чего данные стираются
MESSAGE_TTL_SECONDS=1800

# Таймаут S2S-запросов между серверами (секунды)
S2S_TIMEOUT_SECONDS=10

# IP доверенного прокси (Nginx). "*" — доверять всем (не рекомендуется в проде)
TRUSTED_PROXY=127.0.0.1

# Публичный URL, под которым раздаются загруженные файлы
PUBLIC_BASE_URL=http://localhost:5050

# Режим федерации: closed | allowlist | open
# closed — весь S2S отклоняется (дефолт, сервер невидим);
# allowlist — спаривание только вручную, работают подписанные запросы из server_registry;
# open — спаривание через /s2s/link_request + подписанные запросы.
FEDERATION_MODE=closed

# TURN для звонков (клиент забирает параметры через /api/server_info).
# TURN_ENABLED=0 — сервер не отдаёт TURN, клиент ходит напрямую/STUN.
TURN_ENABLED=1
TURN_HOST=
TURN_PORT=3478
TURN_USER=
TURN_PASS=

# Публичный манифест обновлений APK (для GitHub Releases — URL на
# raw.githubusercontent.com); пусто = локальный /api/diag/update.
UPDATE_MANIFEST_URL=

# GitHub-зеркало обновлений: repo вида owner/name (пусто = выкл).
# Проверка по расписанию; AUTO_UPDATE_PULL=1 — молча тянуть без кнопки.
GITHUB_REPO=
UPDATE_CHECK_ENABLED=1
UPDATE_CHECK_HOURS=6
AUTO_UPDATE_PULL=0
